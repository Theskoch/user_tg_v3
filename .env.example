# ── Обязательные ──────────────────────────────────────────────────────────────

# Секретный ключ Flask (сессии, куки)
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замени_на_случайный_ключ

# Telegram Bot Token (из @BotFather)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Пути к данным (Docker) ────────────────────────────────────────────────────

# SQLite база данных — хранится на хосте в ./data/
DATABASE_URL=sqlite:////data/users.db

# Лог файл авторизации — хранится на хосте в ./data/
LOG_PATH=/data/auth_debug.log

# ── Telegram Mini App (опционально) ───────────────────────────────────────────

# Публичный URL приложения (нужен для ссылок из бота)
WEBAPP_URL=https://your-domain.com

# Username бота без @ (например: my_vpn_bot)
BOT_USERNAME=your_bot_username

# Короткое имя Mini App (из настроек бота в @BotFather)
WEBAPP_SHORT_NAME=app

# ── Безопасность ──────────────────────────────────────────────────────────────

# true  = куки только по HTTPS (продакшн)
# false = куки по HTTP (локальная разработка)
SESSION_COOKIE_SECURE=true

# CORS: разрешённый origin для /api/* (оставь пустым если фронт на том же домене)
ALLOWED_ORIGIN=
